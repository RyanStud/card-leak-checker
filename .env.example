APP_NAME=Card Leak Checker
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/card-leak-checker/

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=card_leak_checker

SESSION_NAME=cardleak_session
SECURITY_LOG_RETENTION_DAYS=90
SECURITY_LOG_CLEANUP_PROBABILITY=2

MAIL_MODE=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@cardleak.local
MAIL_FROM_NAME=Card Leak Checker

TOTP_ISSUER=CardLeakChecker

# Username publico do bot (sem @), usado para gerar link de vinculacao
TELEGRAM_BOT_USERNAME=
ADMIN_ELEVATION_TTL=900
# TELEGRAM_MODE: log | api | polling
#   log     - sem integracao real, mensagens vao para storage/logs/app.log
#   api     - usa webhook publico, requer setWebhook configurado
#   polling - script CLI consulta getUpdates em loop, util quando o ambiente
#             nao recebe webhooks externos (ex.: lab atras de VPN)
TELEGRAM_MODE=log
# Intervalo (segundos) do long-polling. Usado apenas quando TELEGRAM_MODE=polling.
TELEGRAM_POLLING_INTERVAL=10

# SECRET_MASTER_KEY agora fica em variável de ambiente do SO.
# Rode "composer setup" (ou "composer install") para configurá-la uma única vez.
# Windows: gravada via setx (escopo do usuário).
# Linux/macOS: gravada em ~/.bashrc ou ~/.zshrc.
#
# MASTER_KEY_FILE permanece como fallback legado. Deixe vazio se usar a env var.
MASTER_KEY_FILE=
SECRETS_FILE=config/secrets.enc

# Arquivo CSV de exemplo para import de cartoes vazados
LEAKED_CARDS_SAMPLE_CSV=database/sample_leaked_cards.csv

# Criptografia hibrida (S.3.1).
# CERTIFICADO controla a fonte da chave:
#   ambiente -> usa o certificado do servidor (HYBRID_CERT_PATH/KEY abaixo). Ex.: VM com Let's Encrypt acessivel.
#   web      -> usa o par RSA proprio do app (storage/keys, auto-assinado), ignorando os caminhos.
#               Use em hospedagem compartilhada (ex.: Hostinger), onde a chave privada do TLS nao e acessivel.
#   (vazio)  -> auto: usa os caminhos se ambos estiverem definidos; senao, par proprio do app.
# Obs.: no modo 'ambiente' o certificado precisa ser RSA (RSA-OAEP nao funciona com ECDSA)
# e o usuario do web server precisa conseguir LER a chave privada.
CERTIFICADO=
HYBRID_CERT_PATH=/etc/letsencrypt/live/default/fullchain.pem
HYBRID_PRIVATE_KEY_PATH=/etc/letsencrypt/live/default/privkey.pem