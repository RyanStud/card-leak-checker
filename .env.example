APP_NAME=Card Leak Checker
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/card-leak-checker/

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=card_leak_checker

SESSION_NAME=cardleak_session
SECURITY_LOG_RETENTION_DAYS=90
SECURITY_LOG_CLEANUP_PROBABILITY=2

MAIL_MODE=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@cardleak.local
MAIL_FROM_NAME=Card Leak Checker

TOTP_ISSUER=CardLeakChecker

# Username publico do bot (sem @), usado para gerar link de vinculacao
TELEGRAM_BOT_USERNAME=
ADMIN_ELEVATION_TTL=900
TELEGRAM_MODE=log

# Use um caminho absoluto para a chave mestra
MASTER_KEY_FILE=C:\caminho\absoluto\cardleak.masterkey
SECRETS_FILE=config/secrets.enc

# Arquivo CSV de exemplo para import de cartoes vazados
LEAKED_CARDS_SAMPLE_CSV=database/sample_leaked_cards.csv
